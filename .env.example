# SlopGuard needs no credentials to run -- the judge layer is fully local
# (keyword-heuristic based, see slopguard/judge.py). This file is kept as
# a placeholder in case you later add the GitHub Action PR-commenting
# feature, which needs a token to post comments.

# Only needed for the GitHub Action to post PR comments (not required to
# run scans locally or via the API)
GITHUB_TOKEN=
